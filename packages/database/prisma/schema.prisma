datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  FACULTY
  HOD
  DEPARTMENT_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum StudentProgram {
  UG
  PG
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  GRADUATED
}

enum FacultyStatus {
  ACTIVE
  ON_LEAVE
  RETIRED
}

enum RequestCategory {
  COURSE_REGISTRATION
  BONAFIDE_CERTIFICATE
  LEAVE_OF_ABSENCE
  LAB_ACCESS
  PROJECT_APPROVAL
  SPECIAL_PERMISSION
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  CANCELLED
}

enum WorkflowStage {
  FACULTY_REVIEW
  HOD_REVIEW
  FINAL_DECISION
}

enum WorkflowAction {
  SUBMIT
  APPROVE_STAGE
  REJECT
  REQUEST_CHANGES
  RESUBMIT
  CANCEL
  OVERRIDE_APPROVE
}

enum ProposalEligibility {
  UG
  PG
  BOTH
}

enum ProposalStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AllocationStatus {
  ACTIVE
  REASSIGNED
  CANCELLED
}

enum ApplicationStatus {
  SUBMITTED
  WITHDRAWN
  SELECTED
  REJECTED
}

enum NotificationType {
  REQUEST_SUBMITTED
  APPROVAL_PENDING
  REQUEST_APPROVED
  REQUEST_REJECTED
  CHANGES_REQUESTED
  REQUEST_RESUBMITTED
  PROJECT_PUBLISHED
  PROJECT_ALLOCATED
  PROJECT_REASSIGNED
  PROJECT_CANCELLED
}

enum ApprovalTaskStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  CANCELLED
}

enum ReviewerAssignmentPolicy {
  ROLE
  DEPARTMENT_HOD
  REQUESTER_SELECTED
}

model Department {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  proposals       ProjectProposal[]
  requests        DepartmentalRequest[]
  programs        AcademicProgram[]
  facultyProfiles FacultyProfile[]

  @@map("departments")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  status       UserStatus @default(ACTIVE)
  departmentId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  studentProfile StudentProfile?
  facultyProfile FacultyProfile?

  requestsInitiated     DepartmentalRequest[]    @relation("Requester")
  requestsReviewed      DepartmentalRequest[]    @relation("TargetReviewer")
  workflowDecisions     RequestWorkflowHistory[] @relation("ActorDecisions")
  assignedApprovalTasks ApprovalTask[]           @relation("AssignedApprovalTasks")
  uploadedAttachments   DocumentAttachment[]     @relation("AttachmentUploader")
  proposalsCreated      ProjectProposal[]        @relation("FacultySupervisor")
  projectPreferences    ProjectPreference[]      @relation("StudentPreferences")
  studentAllocations    ProjectAllocation[]      @relation("AllocatedStudent")
  allocationsMade       ProjectAllocation[]      @relation("AllocatingAdmin")
  notifications         Notification[]           @relation("UserNotifications")
  auditActions          AuditLog[]               @relation("ActorAuditLogs")

  @@index([role, status])
  @@index([departmentId])
  @@map("users")
}

model StudentProfile {
  id                String         @id @default(uuid())
  userId            String         @unique
  rollNumber        String         @unique
  program           StudentProgram
  academicProgramId String?
  batchYear         Int
  currentSemester   Int
  cgpa              Float?
  status            StudentStatus  @default(ACTIVE)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  academicProgram AcademicProgram? @relation(fields: [academicProgramId], references: [id], onDelete: Restrict)

  @@index([program, batchYear])
  @@map("student_profiles")
}

model FacultyProfile {
  id                 String        @id @default(uuid())
  userId             String        @unique
  employeeId         String        @unique
  departmentId       String?
  designation        String
  maxProjectCapacity Int           @default(5)
  specialization     String?
  status             FacultyStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@map("faculty_profiles")
}

model DepartmentalRequest {
  id                   String          @id @default(uuid())
  requesterId          String
  departmentId         String
  category             RequestCategory
  categoryConfigId     String?
  workflowDefinitionId String?
  academicProgramId    String?
  academicTermId       String?
  title                String
  description          String
  academicContext      Json            @default("{}")
  currentStatus        RequestStatus   @default(DRAFT)
  currentStage         WorkflowStage?
  targetReviewerId     String?
  priority             String          @default("NORMAL")
  submittedAt          DateTime?
  decidedAt            DateTime?
  version              Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  requester          User                   @relation("Requester", fields: [requesterId], references: [id], onDelete: Restrict)
  department         Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  targetReviewer     User?                  @relation("TargetReviewer", fields: [targetReviewerId], references: [id], onDelete: SetNull)
  categoryConfig     RequestCategoryConfig? @relation(fields: [categoryConfigId], references: [id], onDelete: Restrict)
  workflowDefinition WorkflowDefinition?    @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict)
  academicProgram    AcademicProgram?       @relation(fields: [academicProgramId], references: [id], onDelete: Restrict)
  academicTerm       AcademicTerm?          @relation(fields: [academicTermId], references: [id], onDelete: Restrict)

  workflowHistory RequestWorkflowHistory[]
  approvalTasks   ApprovalTask[]
  attachments     DocumentAttachment[]

  @@index([requesterId, currentStatus])
  @@index([departmentId, currentStatus])
  @@index([currentStage, currentStatus])
  @@index([category, createdAt])
  @@index([currentStatus, submittedAt])
  @@index([targetReviewerId, currentStatus])
  @@map("departmental_requests")
}

model RequestWorkflowHistory {
  id                        String         @id @default(uuid())
  requestId                 String
  actorId                   String
  action                    WorkflowAction
  stage                     WorkflowStage?
  workflowStageDefinitionId String?
  previousStatus            RequestStatus
  resultingStatus           RequestStatus
  comments                  String?
  rejectionReason           String?
  metadata                  Json           @default("{}")
  createdAt                 DateTime       @default(now())

  request                 DepartmentalRequest      @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor                   User                     @relation("ActorDecisions", fields: [actorId], references: [id], onDelete: Restrict)
  workflowStageDefinition WorkflowStageDefinition? @relation(fields: [workflowStageDefinitionId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@map("request_workflow_history")
}

model ProjectProposal {
  id                  String              @id @default(uuid())
  title               String
  description         String
  supervisorId        String
  departmentId        String
  academicTerm        String
  academicTermId      String?
  ugPgEligibility     ProposalEligibility @default(BOTH)
  capacity            Int                 @default(2)
  prerequisites       String?
  applicationDeadline DateTime?
  status              ProposalStatus      @default(DRAFT)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  supervisor User          @relation("FacultySupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  department Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  term       AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: Restrict)

  preferences ProjectPreference[]
  allocations ProjectAllocation[]

  @@index([departmentId, status])
  @@index([supervisorId, academicTerm])
  @@map("project_proposals")
}

model ProjectPreference {
  id             String            @id @default(uuid())
  studentId      String
  proposalId     String
  rank           Int
  academicTerm   String
  academicTermId String?
  status         ApplicationStatus @default(SUBMITTED)
  statement      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  student  User            @relation("StudentPreferences", fields: [studentId], references: [id], onDelete: Restrict)
  proposal ProjectProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  term     AcademicTerm?   @relation(fields: [academicTermId], references: [id], onDelete: Restrict)

  @@unique([studentId, proposalId, academicTerm])
  @@unique([studentId, rank, academicTerm])
  @@map("project_preferences")
}

model ProjectAllocation {
  id                 String           @id @default(uuid())
  proposalId         String
  studentId          String
  allocatedById      String
  academicTerm       String
  academicTermId     String?
  status             AllocationStatus @default(ACTIVE)
  allocatedAt        DateTime         @default(now())
  cancelledAt        DateTime?
  cancellationReason String?
  reassignedFromId   String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  proposal       ProjectProposal     @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  student        User                @relation("AllocatedStudent", fields: [studentId], references: [id], onDelete: Restrict)
  allocatedBy    User                @relation("AllocatingAdmin", fields: [allocatedById], references: [id], onDelete: Restrict)
  term           AcademicTerm?       @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  reassignedFrom ProjectAllocation?  @relation("AllocationReassignment", fields: [reassignedFromId], references: [id], onDelete: Restrict)
  reassignments  ProjectAllocation[] @relation("AllocationReassignment")

  @@index([proposalId, status])
  @@index([studentId, academicTerm, status])
  @@map("project_allocations")
}

model Notification {
  id                String           @id @default(uuid())
  userId            String
  title             String
  message           String
  type              NotificationType
  isRead            Boolean          @default(false)
  readAt            DateTime?
  linkUrl           String?
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime         @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  action        String
  entityType    String
  entityId      String
  beforeState   Json?
  afterState    Json?
  ipAddress     String?
  userAgent     String?
  correlationId String?
  createdAt     DateTime @default(now())

  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model AcademicProgram {
  id           String         @id @default(uuid())
  departmentId String
  code         String
  name         String
  degreeLevel  StudentProgram
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  department Department            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  students   StudentProfile[]
  requests   DepartmentalRequest[]

  @@unique([departmentId, code])
  @@index([departmentId, degreeLevel, isActive])
  @@map("academic_programs")
}

model AcademicTerm {
  id           String    @id @default(uuid())
  code         String    @unique
  name         String
  academicYear String
  startsAt     DateTime?
  endsAt       DateTime?
  isActive     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  requests    DepartmentalRequest[]
  proposals   ProjectProposal[]
  preferences ProjectPreference[]
  allocations ProjectAllocation[]

  @@index([academicYear, isActive])
  @@map("academic_terms")
}

model RequestCategoryConfig {
  id             String           @id @default(uuid())
  code           String           @unique
  legacyCategory RequestCategory? @unique
  name           String
  description    String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  requests  DepartmentalRequest[]
  workflows WorkflowDefinition[]

  @@map("request_category_configs")
}

model WorkflowDefinition {
  id               String   @id @default(uuid())
  categoryConfigId String?
  name             String
  version          Int
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  categoryConfig RequestCategoryConfig?    @relation(fields: [categoryConfigId], references: [id], onDelete: Restrict)
  stages         WorkflowStageDefinition[]
  requests       DepartmentalRequest[]

  @@unique([categoryConfigId, version])
  @@index([categoryConfigId, isActive])
  @@map("workflow_definitions")
}

model WorkflowStageDefinition {
  id                   String                   @id @default(uuid())
  workflowDefinitionId String
  position             Int
  name                 String
  workflowStage        WorkflowStage
  requiredReviewerRole Role
  assignmentPolicy     ReviewerAssignmentPolicy @default(ROLE)
  isMandatory          Boolean                  @default(true)
  escalationConfig     Json?
  createdAt            DateTime                 @default(now())

  workflowDefinition WorkflowDefinition       @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict)
  tasks              ApprovalTask[]
  history            RequestWorkflowHistory[]

  @@unique([workflowDefinitionId, position])
  @@index([workflowDefinitionId, workflowStage])
  @@map("workflow_stage_definitions")
}

model ApprovalTask {
  id                        String             @id @default(uuid())
  requestId                 String
  workflowStageDefinitionId String
  assignedReviewerId        String?
  assignedRole              Role?
  status                    ApprovalTaskStatus @default(PENDING)
  createdAt                 DateTime           @default(now())
  completedAt               DateTime?

  request                 DepartmentalRequest     @relation(fields: [requestId], references: [id], onDelete: Restrict)
  workflowStageDefinition WorkflowStageDefinition @relation(fields: [workflowStageDefinitionId], references: [id], onDelete: Restrict)
  assignedReviewer        User?                   @relation("AssignedApprovalTasks", fields: [assignedReviewerId], references: [id], onDelete: Restrict)

  @@index([assignedReviewerId, status, createdAt])
  @@index([assignedRole, status, createdAt])
  @@index([requestId, status])
  @@map("approval_tasks")
}

model DocumentAttachment {
  id           String   @id @default(uuid())
  requestId    String
  uploaderId   String
  originalName String
  storageKey   String   @unique
  mimeType     String
  sizeBytes    BigInt
  createdAt    DateTime @default(now())

  request  DepartmentalRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  uploader User                @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([uploaderId, createdAt])
  @@map("document_attachments")
}
