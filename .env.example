# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/department_management?schema=public

# Security and Authentication
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=24h
COOKIE_SECRET=replace_with_another_secure_secret_for_cookies

# CORS Allowed Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=info
